# Versionado de propósito: SOMENTE valores locais (docker compose). Nunca coloque
# credenciais ou endpoints reais aqui.
# Completo por conta própria: os testes não dependem do .env do desenvolvedor.
NODE_ENV=test
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_WAGER_EVENTS_QUEUE_NAME=wager-events.fifo
HEALTH_CHECK_TIMEOUT_MS=2000
# Desligado: os testes que precisam do consumidor sobem o próprio, com filas isoladas.
SQS_CONSUMER_ENABLED=false
# Desligado: os testes do publisher sobem o próprio, com filas isoladas.
OUTBOX_PUBLISHER_ENABLED=false
# Desligado: os testes do worker de pendentes chamam o ciclo direto ou sobem o próprio.
PENDING_REFERENCE_WORKER_ENABLED=false
