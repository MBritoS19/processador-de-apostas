NODE_ENV=development
HTTP_PORT=3000

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

# LocalStack. Fora do ambiente local, remova AWS_ENDPOINT_URL e use credenciais reais via IAM.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Lidas pela aplicação E pelo docker compose (script de criação das filas).
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_WAGER_EVENTS_QUEUE_NAME=wager-events.fifo
# Lida pelo docker compose (redrive para a DLQ, rede de segurança). Mudar exige recriar o container do LocalStack.
# Fica acima de SQS_CONSUMER_MAX_ATTEMPTS: o consumidor decide a DLQ com motivo; ver ARCHITECTURE.md §18.
SQS_MAX_RECEIVE_COUNT=10

HEALTH_CHECK_TIMEOUT_MS=2000

# Consumidor SQS (Fase 5). Números e motivos no ARCHITECTURE.md §18.
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_RETRY_BASE_SECONDS=30
SQS_RETRY_MAX_SECONDS=300
SQS_CONSUMER_MAX_ATTEMPTS=5
SQS_SHUTDOWN_TIMEOUT_MS=25000

# Outbox publisher (Fase 6). Números e motivos no ARCHITECTURE.md §19.
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=500
# Timeout do SendMessageBatch (sem retries do SDK): + 2000 deve caber no idle_in_transaction do claim (o lock fica segurado no envio).
OUTBOX_SQS_TIMEOUT_MS=3000
OUTBOX_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
OUTBOX_STUCK_ATTEMPTS=10
OUTBOX_SHUTDOWN_TIMEOUT_MS=25000
